# SRGE edge proxy (Caddy v2) — single edge port 8080, Tailscale-only HTTPS.
# No public ports; all services bind to 127.0.0.1.

:8080 {
	# Coder web UI + its root-level assets (dashboard JS/CSS loaded from /)
	handle /coder {
		uri strip_prefix /coder
		reverse_proxy http://srge-coder:7080
	}
	# Coder loads its JS/CSS from the root (e.g. /dashboard.xxx.js).
	# Forward those root-level assets to Coder.
	handle /dashboard.{js,css,map} {
		reverse_proxy http://srge-coder:7080
	}

	# LiteLLM API + UI
	handle /litellm {
		uri strip_prefix /litellm
		reverse_proxy http://srge-litellm:4000
	}
	# LiteLLM's Swagger UI loads assets from /swagger/ (root-level).
	handle /swagger/* {
		reverse_proxy http://srge-litellm:4000
	}

	# Open WebUI
	handle /webui {
		uri strip_prefix /webui
		reverse_proxy http://srge-open-webui:8080
	}
	# WebUI loads its JS/CSS from /static/ (root-level).
	handle /static/* {
		reverse_proxy http://srge-open-webui:8080
	}

	# Grafana
	handle /grafana {
		uri strip_prefix /grafana
		reverse_proxy http://srge-grafana:3000
	}

	# SRGE portal landing page (catch-all)
	handle / {
		root * /srv/portal
		file_server
	}

	# Health endpoint
	handle /healthz {
		respond "ok" 200
	}
}
