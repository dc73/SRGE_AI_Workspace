# SRGE AI Workspace — environment template.
# Copy to .env and fill in real values. .env is gitignored (secrets live outside Git).

# --- Platform branding (configurable, no source edits needed) ---
SRGE_LAB_NAME="Embry-Riddle Space Robotics and Generative Estimation Lab"
SRGE_PLATFORM_NAME="SRGE AI Workspace"
SRGE_LOGO_PATH=/app/assets/srge-logo.png
SRGE_COLOR_PRIMARY="#0B2545"
SRGE_COLOR_ACCENT="#C9A227"
SRGE_SUPPORT_EMAIL=ai-workspace@erau.edu
SRGE_LAB_WEBSITE=https://erau.edu/research-and-innovation/labs/space-robotics-and-generative-estimation-lab
SRGE_DOCS_URL=
SRGE_ANNOUNCEMENT=""

# --- Inference gateway ---
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_MODEL_NAME=srge/qwen3.8-27b
LITELLM_VLLM_API_BASE=http://qwen38:8000/v1
LITELLM_VLLM_API_KEY=

# --- Per-tier AI limits (requests/min, tokens/min, max parallel) ---
SRGE_TIER_ADMIN_RPM=60
SRGE_TIER_ADMIN_TPM=100000
SRGE_TIER_ADMIN_PARALLEL=3
SRGE_TIER_RESEARCHER_RPM=30
SRGE_TIER_RESEARCHER_TPM=50000
SRGE_TIER_RESEARCHER_PARALLEL=2
SRGE_TIER_STUDENT_RPM=15
SRGE_TIER_STUDENT_TPM=20000
SRGE_TIER_STUDENT_PARALLEL=1
SRGE_TIER_GUEST_RPM=5
SRGE_TIER_GUEST_TPM=5000
SRGE_TIER_GUEST_PARALLEL=1

# --- Workspace defaults (configurable) ---
SRGE_WS_CPU=4
SRGE_WS_MEMORY=12g
SRGE_WS_PIDS=512
SRGE_WS_IDLE_TIMEOUT_MINUTES=60
SRGE_WS_MAX_PER_USER=1

# --- Admission / capacity thresholds ---
SRGE_ADMISSION_GPU_UTIL_PCT=95
SRGE_ADMISSION_GPU_MEM_PCT=92
SRGE_ADMISSION_QUEUE_MAX=8

# --- Endpoints ---
SRGE_CODER_URL=http://127.0.0.1:8081
SRGE_GRAFANA_URL=http://127.0.0.1:3000
SRGE_PROMETHEUS_URL=http://127.0.0.1:9400

# --- Database (Postgres) ---
SRGE_DB_USER=coder
SRGE_DB_PASSWORD=coder
SRGE_DB_NAME=coder
